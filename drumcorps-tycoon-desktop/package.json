{
 "name": "drumcorps-tycoon",
 "version": "1.0.0",
 "description": "Drumcorps Tycoon by Alex",
 "author": "Alex",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win portable --publish never"
 },
 "devDependencies": {
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3"
 },
 "build": {
  "appId": "com.alex.drumcorpstycoon",
  "productName": "Drumcorps Tycoon",
  "files": [
   "main.js",
   "preload.js",
   "index.html"
  ],
  "win": {
   "target": [
    "portable"
   ]
  },
  "portable": {
   "artifactName": "DrumcorpsTycoon.exe"
  }
 }
}